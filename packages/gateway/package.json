{
  "name": "@render-factory/gateway",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.ui.config.ts && tsc --project tsconfig.build.json",
    "build:server": "tsc --project tsconfig.build.json",
    "build:ui": "vite build --config vite.ui.config.ts",
    "dev:ui": "vite --config vite.ui.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hono/node-server": "^2.0.6",
    "@render-factory/sdk": "workspace:*",
    "@render-factory/store": "workspace:*",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.0",
    "vite": "^8.1.0",
    "vitest": "^2.0.0"
  }
}
