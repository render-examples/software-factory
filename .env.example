# Shared by all processes.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/render_factory

# Gateway.
GITHUB_WEBHOOK_SECRET=
PORT=3000

# Optional. Overrides the actors list in factory.config.ts.
# M3 replaces this with a live permission check.
FACTORY_GITHUB_ACTORS=github-login

# Dispatcher and workflows host.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=factory-workflows
RENDER_WORKSPACE_ID=

# Workflows host — model providers.
ANTHROPIC_API_KEY=

# GitHub App credentials (required — no PAT fallback).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Optional GitHub API base URL override.
GITHUB_API_URL=
