# One repository, one intake label, one maintainer allowlist
FACTORY_REPO=owner/repo
FACTORY_LABEL=factory
FACTORY_GITHUB_ACTORS=github-login

# Shared Postgres store
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/render_factory
FACTORY_DB_POOL_MAX=2
FACTORY_EVENT_RETENTION_DAYS=30
FACTORY_RUN_RETENTION_DAYS=90

# Gateway
# Use at least 32 random characters.
GITHUB_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows host
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
