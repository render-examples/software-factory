# Both services. Required by phase runs for coordination; `npm run dev:postgres` starts this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/software_factory

# Both services: Render API key (the gateway starts tasks; workflows manage sandboxes and cancel runs).
RENDER_API_KEY=

# Gateway.
PORT=3000
# Secret configured on the GitHub App's webhook.
GITHUB_WEBHOOK_SECRET=
# Protects the trace UI.
FACTORY_ADMIN_TOKEN=
# Slug of the factory-workflows service; tasks start as <slug>/<task>.
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows.
RENDER_WORKSPACE_ID=
# GitHub App credentials; the installation comes from each webhook.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Model provider key. Use a spend-capped key: it enters the sandbox for agent runs.
ANTHROPIC_API_KEY=
# Optional: GitHub API base URL, for GitHub Enterprise Server.
GITHUB_API_URL=
# Optional: minimum gap in ms between Sandbox API calls from one process (default 1000).
# RENDER_API_MIN_INTERVAL_MS=

# Live evals (npm run eval): the App installation id for the target repository.
# FACTORY_EVAL_INSTALLATION_ID=
