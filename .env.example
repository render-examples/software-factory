# Copy to `.env` for `docker compose up`. All values have safe dev defaults in
# docker-compose.yaml, so the stack boots even with this file empty — but you
# need a provider key below to actually run an agent.

# --- Provider credentials (set one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Gateway auth ---
# Bearer token required by the gateway (default: dev-key). Use a strong value
# outside local dev.
RENDER_AGENTS_API_KEY=dev-key

# 32+ char secret used to encrypt OAuth tokens at rest + sign state.
RENDER_AGENTS_ENCRYPTION_KEY=dev-only-change-me-0000000000000000

# --- Behavior ---
# Set to 1 to require human approval for gated tools.
RENDER_AGENTS_STRICT_APPROVAL=

# --- Slack channel ---
# Slack app: Event Subscriptions -> https://<host>/channels/slack
#            Interactivity       -> https://<host>/slack/interactions
# Bot scopes: app_mentions:read, chat:write, channels:history, groups:history,
#             im:history, reactions:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Optional: restrict to a specific Slack team.
# SLACK_TEAM_ID=T...

# --- GitHub demo (issue-to-pr + pr-review workflows) ---
# Fine-grained PAT with Contents RW, Pull requests RW, Issues RW on the target
# repo. Used to read issues/PRs, comment, push branches, and open/review PRs.
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook (authenticates inbound deliveries).
GITHUB_WEBHOOK_SECRET=
# The login the PAT acts as. Events authored by this account are ignored so the
# bot's own comments/labels don't trigger new runs (loop guard).
GITHUB_BOT_LOGIN=
# Commit identity for the pushed branch (optional; sensible defaults otherwise).
GIT_AUTHOR_NAME=render-agent
GIT_AUTHOR_EMAIL=render-agent@users.noreply.github.com
# Where clones live (optional; defaults to a temp dir). Ephemeral per run.
# RENDER_WORKSPACE_DIR=/tmp/render-agents-workspaces

# --- Workflows local-dev (Lane A via Render Workflows local task server) ---
# Only for the hybrid local-dev flow (see examples/demo/README.md). When set on
# the gateway/worker, workflow roots + agent.task() children are triggered
# against the Render CLI local task server instead of running in-process.
# RENDER_USE_LOCAL_DEV=true
# Local task server URL (default http://localhost:8120).
# RENDER_LOCAL_DEV_URL=http://localhost:8120
# Workflow slug prefix used to build task identifiers ("<slug>/agent@<plan>").
# RENDER_WORKFLOW_SLUG=local
