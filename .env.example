# Required — Claude API key for agent execution
ANTHROPIC_API_KEY=

# Redis (local Docker Compose default)
REDIS_URL=redis://localhost:6379

# Workflow slug (any value works for local dev; must match deployed slug in production)
RENDER_WORKFLOW_SLUG=factory-workflows

# Optional — GitHub fine-grained PAT (needed for spec-to-pr / pr-review / pr-fix)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Optional — Slack (needed for /channels/slack)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
