# One repository, one intake label, one maintainer allowlist.
FACTORY_REPO=owner/repo
FACTORY_LABEL=factory
# Optional. Overrides the actors list in factory.config.ts.
FACTORY_GITHUB_ACTORS=github-login

# Shared by both processes.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/render_factory
# The gateway uses this to dispatch tasks; the workflows host to run sandboxes.
RENDER_API_KEY=

# Gateway. Use at least 32 random characters for the webhook secret.
GITHUB_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows host.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
RENDER_WORKSPACE_ID=
