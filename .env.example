# `npm run setup:render` copies these values into the Render env groups render.yaml links; see
# docs/configuration.md#environment-groups.

# Both services: Render API key (the gateway starts tasks; workflows manage sandboxes and cancel runs).
RENDER_API_KEY=
# Both services: Postgres. On Render, the Blueprint links factory-db to the gateway and
# `npm run setup:render -- --link-database` gives Workflows the same URL; locally, use a local Postgres or
# factory-db's external URL with ?sslmode=verify-full. See docs/configuration.md#database.
DATABASE_URL=

# Gateway.
PORT=3000
# Secret configured on the GitHub App's webhook.
GITHUB_WEBHOOK_SECRET=
# Bearer token for the gateway's event streams. setup:render generates one when this is empty.
EVENTS_READ_TOKEN=
# Slug of the factory-workflows service; tasks start as <slug>/<task>.
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows.
RENDER_WORKSPACE_ID=
# GitHub App credentials; the installation comes from each webhook.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Model provider key. Use a spend-capped key: it enters the sandbox for agent runs.
ANTHROPIC_API_KEY=
# Optional: GitHub API base URL, for GitHub Enterprise Server.
GITHUB_API_URL=
