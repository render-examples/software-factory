{
  "name": "render-factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#factory-agents": "./app/agents/index.ts",
    "#factory-run-store": "./app/lib/run-store.ts",
    "#factory-sdk": "./sdk/index.ts",
    "#factory-sdk/*": "./sdk/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:gateway": "tsx app/src/server.ts",
    "start:workflows": "tsx app/src/workflows.ts",
    "dev:gateway": "RENDER_USE_LOCAL_DEV=true node --env-file=.env node_modules/.bin/tsx watch app/src/server.ts",
    "dev:workflows": "render workflows dev -- node --env-file=.env node_modules/.bin/tsx app/src/workflows.ts",
    "dev:redis": "docker compose up redis",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "lint": "biome lint --error-on-warnings app sdk scripts integration",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_LIVE_INTEGRATION=1 vitest run integration",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@hono/node-server": "^2.0.0",
    "@renderinc/sdk": "^0.7.0",
    "hono": "^4.0.0",
    "redis": "^5.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
