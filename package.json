{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-examples/software-factory.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start:gateway": "tsx app/entrypoints/gateway.ts",
    "start:workflows": "tsx app/entrypoints/workflows.ts",
    "dev:gateway": "node --env-file=.env node_modules/.bin/tsx watch app/entrypoints/gateway.ts",
    "dev:workflows": "render workflows dev -- node --env-file=.env node_modules/.bin/tsx app/entrypoints/workflows.ts",
    "setup:app": "node --env-file-if-exists=.env --import tsx scripts/setup-app.ts",
    "setup:render": "node --env-file-if-exists=.env --import tsx scripts/setup-render.ts",
    "setup:github": "node --env-file-if-exists=.env --import tsx scripts/setup-github.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "lint": "biome lint --error-on-warnings app scripts tests factory.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "python:lock": "cd python && uv lock --python 3.11 && uv export --frozen --no-header --format requirements-txt --hashes -o requirements.txt"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@hono/node-server": "^2.0.0",
    "@renderinc/sdk": "^1.3.0",
    "esbuild": "^0.28.2",
    "hono": "^4.0.0",
    "tar": "^7.5.22",
    "tsx": "^4.19.0",
    "typebox": "1.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
