{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start:gateway": "tsx app/src/server.ts",
    "start:workflows": "tsx app/src/workflows.ts",
    "dev:gateway": "node --env-file=.env node_modules/.bin/tsx watch app/src/server.ts",
    "dev:workflows": "render workflows dev -- node --env-file=.env node_modules/.bin/tsx app/src/workflows.ts",
    "dev:postgres": "docker compose up postgres",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "setup:app": "node --env-file-if-exists=.env --import tsx scripts/setup-app.ts",
    "setup:github": "node --env-file-if-exists=.env --import tsx scripts/setup-github.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval.ts",
    "lint": "biome lint --error-on-warnings app scripts tests factory.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@hono/node-server": "^2.0.0",
    "@renderinc/sdk": "^1.2.0",
    "esbuild": "^0.28.2",
    "hono": "^4.0.0",
    "pg": "^8.23.0",
    "tar": "^7.5.22",
    "tsx": "^4.19.0",
    "typebox": "1.3.7",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
