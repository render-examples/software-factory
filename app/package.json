{
  "name": "@render-factory/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "First-party render-factory workflows: spec-to-pr, pr-review, and the gateway + workflows host.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "dev": "tsx watch src/server.ts",
    "start": "tsx dist/src/server.js",
    "workflows": "tsx dist/src/workflows.js",
    "dev:workflows": "render workflows dev -- tsx src/workflows.ts"
  },
  "dependencies": {
    "@render-factory/engine": "workspace:*",
    "@render-factory/gateway": "workspace:*",
    "@render-factory/sandbox-render": "workspace:*",
    "@render-factory/sdk": "workspace:*",
    "@render-factory/store": "workspace:*",
    "@renderinc/sdk": "^0.6.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.5.0"
  }
}
