{
  "credentials": {
    "github-implementer": {
      "type": "env",
      "envVar": "GITHUB_TOKEN"
    },
    "github-reviewer": {
      "type": "env",
      "envVar": "GITHUB_REVIEWER_TOKEN"
    },
    "render-api": {
      "type": "env",
      "envVar": "RENDER_API_KEY"
    }
  },

  "defaults": {
    "escalate": ["deploy"],
    "deny": ["sandbox__terminate"]
  },

  "workflows": {
    "chat-turn": {
      "credentials": { "github": "github-implementer" },
      "escalate": ["start_workflow"]
    },
    "spec-to-pr": {
      "credentials": { "github": "github-implementer" }
    },
    "pr-review": {
      "credentials": { "github": "github-reviewer" }
    },
    "pr-fix": {
      "credentials": { "github": "github-implementer" }
    }
  }
}
